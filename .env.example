# Renpho Health app credentials
RENPHO_EMAIL=your-email@example.com
RENPHO_PASSWORD=your-password

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: also write size-capped log files to this directory.
# Logs always go to stderr; unset means no log files are written.
# LOG_DIR=/var/log/renpho-mcp
