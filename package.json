{
  "name": "renpho-mcp-server",
  "version": "1.2.1",
  "description": "MCP server for Renpho smart scale body composition data",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "renpho-mcp-server": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./api": {
      "types": "./dist/services/renpho-api.d.ts",
      "default": "./dist/services/renpho-api.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node scripts/test.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write src/**/*.ts",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "prepare": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^17.2.0",
    "lru-cache": "^10.4.3",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "renpho",
    "smart-scale",
    "body-composition",
    "health",
    "fitness",
    "weight",
    "claude",
    "ai"
  ],
  "author": "Will Mitchell",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
